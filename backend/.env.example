# ============================================================
# Collecta V5 — Variables de Entorno (Backend)
# Copia este archivo como .env y llena los valores reales
# NUNCA subas el archivo .env al repositorio
# ============================================================

# Puerto del servidor Express
PORT=3001

# Entorno (production/development)
NODE_ENV=development

# ---- Base de datos PostgreSQL / Supabase ----
# URL transaccional usada por Prisma Client.
# Para Supabase serverless usa el pooler recomendado por el dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.supabase.co/DB_NAME?sslmode=require

# URL directa usada por Prisma para migraciones/operaciones administrativas.
# En Supabase usa la conexion directa o la que indique Prisma en el panel Connect.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.supabase.co/DB_NAME?sslmode=require

# ---- Supabase Storage / Auth opcional ----
# TEMP_PDF_STORAGE_PROVIDER=auto usa Supabase si esta configurado y local-temp si no.
# En produccion/staging remoto usa supabase para no depender del disco local.
TEMP_PDF_STORAGE_PROVIDER=auto
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=statement-pdfs

# Si se habilita Supabase Auth como proveedor externo, el backend verifica JWTs.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# ---- APIs de Inteligencia Artificial ----
# IMPORTANTE: Las API keys de IA se configuran SOLO en variables
# de entorno, NUNCA en la tabla Config de la base de datos.
# Gemini (Google) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---- Autenticación ----
# API Key para autenticación de peticiones (para scripts/automación)
# Mínimo 32 caracteres, usa un generador aleatorio
API_KEY=genera_una_clave_aleatoria_larga_minimo_32_chars
AUTOMATION_ORGANIZATION_ID=
N8N_ORGANIZATION_ID=

# JWT Secret para tokens de sesión (mínimo 32 caracteres)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_aqui_minimo_32_chars

# Compatibilidad tecnica temporal para login local anterior.
# El flujo vigente de producto es signup/login multi-tenant persistido en DB.
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_contraseña_segura

# ---- Evolution API (WhatsApp programático) ----
# Documentación: https://doc.evolution-api.com
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=collecta
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_WEBHOOK_SECRET=your_webhook_secret_here
# Required in production when Evolution webhook is enabled.
# Must identify the Collecta organization that owns this Evolution instance.
EVOLUTION_WEBHOOK_ORGANIZATION_ID=

# ---- Pipeline de detección de pagos (n8n webhook, opcional) ----
PAYMENT_DETECTION_WEBHOOK_URL=
PAYMENT_DETECTION_WEBHOOK_TOKEN=

# ---- Email transaccional opcional ----
# Preferido para SaaS: EMAIL_PROVIDER=resend con RESEND_API_KEY.
# SMTP queda como compatibilidad si el despacho ya tiene proveedor.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---- CORS y Seguridad ----
# Orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_FRONTEND_DOMAIN.example.com
