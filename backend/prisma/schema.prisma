generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String       @id @default(cuid())
  organizationId String       @default("default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?      @unique
  passwordHash   String       @default("")
  role           String       @default("asesor")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Organization {
  id               String            @id @default(cuid())
  nombre           String
  slug             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  clients          Client[]
  operations       Operation[]
  logEntries       LogEntry[]
  configs          Config[]
  whatsAppMessages WhatsAppMessage[]
  agentExecutions  AgentExecution[]
  agentActions     AgentAction[]
  agentConfigs     AgentConfig[]
}

model Client {
  organizationId   String            @default("default")
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id               String            @id @default(cuid())
  rfc              String
  nombre           String
  telefono         String?
  email            String?
  regimen          String?
  categoria        String?
  asesor           String?
  estado           String            @default("ACTIVO")
  notas            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  operations       Operation[]
  logEntries       LogEntry[]
  whatsAppMessages WhatsAppMessage[]
  agentActions     AgentAction[]

  @@unique([organizationId, rfc])
  @@index([organizationId])
}

model Operation {
  organizationId   String            @default("default")
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id               String            @id @default(cuid())
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tipo             String
  descripcion      String?
  monto            Float             @default(0)
  fechaVence       DateTime
  fechaPago        DateTime?
  estatus          String            @default("PENDIENTE")
  asesor           String?
  excluir          Boolean           @default(false)
  archived         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  whatsAppMessages WhatsAppMessage[]

  @@index([organizationId])
  @@index([organizationId, clientId])
}

model LogEntry {
  organizationId String       @default("default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id             String       @id @default(cuid())
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tipo           String
  variante       String?
  resultado      String
  mensaje        String?
  telefono       String?
  modo           String       @default("PRUEBA")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, clientId])
}

model Config {
  organizationId String       @default("default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          String

  @@id([organizationId, key])
  @@index([organizationId])
}

model WhatsAppMessage {
  organizationId  String       @default("default")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id             String     @id @default(cuid())
  operationId    String?
  operation      Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  direction      String     // "OUTGOING" | "INCOMING"
  messageType    String     // "TEXT" | "IMAGE" | "DOCUMENT"
  phone          String
  content        String?
  mediaUrl       String?
  evolutionMsgId String?
  status         String     @default("SENT")
  createdAt      DateTime   @default(now())

  @@index([organizationId])
  @@index([organizationId, clientId])
  @@index([organizationId, operationId])
}

// ─── Agente Autónomo ───────────────────────────────────────────

model AgentExecution {
  organizationId   String        @default("default")
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id               String        @id @default(cuid())
  status           String        @default("PENDING")   // PENDING | RUNNING | PAUSED | COMPLETED | STOPPED | FAILED
  phase            String        @default("COLLECT")   // COLLECT | ANALYZE | EXECUTE | MONITOR
  progress         Int           @default(0)           // 0-100
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  totalActions     Int           @default(0)
  completedActions Int           @default(0)
  failedActions    Int           @default(0)
  cancelledActions Int           @default(0)
  triggeredBy      String        @default("SCHEDULE")  // SCHEDULE | MANUAL | WEBHOOK
  notes            String?
  tenantId         String        @default("default")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  actions          AgentAction[]

  @@index([organizationId])
}

model AgentAction {
  organizationId String         @default("default")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id          String         @id @default(cuid())
  executionId String
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type        String                         // WHATSAPP_MESSAGE | WHATSAPP_PDF | FOLLOWUP | EMAIL
  status      String         @default("PENDING") // PENDING | EXECUTING | COMPLETED | FAILED | CANCELLED
  message     String?
  phone       String?
  sentAt      DateTime?
  error       String?
  tenantId    String         @default("default")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([organizationId])
  @@index([organizationId, clientId])
  @@index([organizationId, executionId])
}

model AgentConfig {
  organizationId   String       @default("default")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id              String   @id @default(cuid())
  tenantId        String   @default("default") @unique
  scheduleEnabled Boolean  @default(true)
  scheduleCron    String   @default("0 9 1,15 * *") // 1 y 15 a las 9:00 AM
  maxDailySends   Int      @default(100)
  rateLimitMs     Int      @default(1500)
  sendPdfEnabled  Boolean  @default(true)
  notifyOnFail    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}
